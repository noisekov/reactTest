{
  "name": "react-test-kanban",
  "version": "1.0.0",
  "private": true,
  "description": "Kanban task board test assignment built with React, TypeScript and Webpack",
  "engines": {
    "node": ">=18.18.0 <19",
    "npm": ">=9"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "npm run start",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "css-loader": "6.11.0",
    "html-webpack-plugin": "5.6.0",
    "mini-css-extract-plugin": "2.9.0",
    "sass": "1.77.8",
    "sass-loader": "14.2.1",
    "style-loader": "3.3.4",
    "ts-loader": "9.5.1",
    "typescript": "5.4.5",
    "webpack": "5.92.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2",
    "gh-pages": "6.1.1"
  }
}
