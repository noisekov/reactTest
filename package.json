{
  "name": "react-webpack-ts-template",
  "version": "1.0.0",
  "private": true,
  "description": "React + TypeScript + Webpack starter configured for Node.js 18.18.0",
  "engines": {
    "node": ">=18.18.0 <19",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "css-loader": "6.11.0",
    "html-webpack-plugin": "5.6.0",
    "mini-css-extract-plugin": "2.9.0",
    "sass": "1.77.8",
    "sass-loader": "14.2.1",
    "style-loader": "3.3.4",
    "ts-loader": "9.5.1",
    "typescript": "5.4.5",
    "webpack": "5.92.1",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  }
}
